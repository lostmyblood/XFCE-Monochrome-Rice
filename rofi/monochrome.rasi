/**
 * Monochrome rofi theme
 * Usage: rofi -show drun -theme ~/.config/rofi/monochrome.rasi
 */

* {
    bg0:        #000000;
    bg1:        #1a1a1a;
    bg2:        #2b2b2b;
    fg0:        #ffffff;
    fg1:        #cccccc;
    fg2:        #888888;
    border-col: #444444;
    selected:   #ffffff;
    selected-fg: #000000;

    background-color:  @bg0;
    text-color:         @fg0;

    font: "monospace 11";
}

window {
    background-color: @bg0;
    border:            1px;
    border-color:      @border-col;
    border-radius:     0px;
    width:              470px;
    height:             557px;
    location:          center;
    padding:           0px;
}

mainbox {
    background-color: @bg0;
    padding:           0px;
    children:          [ inputbar, message, listview ];
}

inputbar {
    background-color: @bg1;
    text-color:         @fg0;
    padding:           12px;
    children:          [ entry ];
    border:            0px 0px 1px 0px;
    border-color:      @border-col;
}

prompt {
    background-color: @bg1;
    text-color:         @fg2;
    padding:           0px 8px 0px 0px;
}

entry {
    background-color: @bg1;
    text-color:         @fg0;
    placeholder:       "Search...";
    placeholder-color: @fg2;
}

message {
    background-color: @bg1;
    text-color:         @fg1;
    border:            0px 0px 1px 0px;
    border-color:      @border-col;
    padding:           8px 12px;
}

listview {
    background-color: @bg0;
    columns:           1;
    lines:             10;
    spacing:           2px;
    padding:           8px;
    fixed-height:      false;
    scrollbar:         false;
}

element {
    background-color: @bg0;
    text-color:         @fg1;
    padding:           8px 12px;
    border-radius:     0px;
}

element normal.normal {
    background-color: @bg0;
    text-color:         @fg1;
}

element alternate.normal {
    background-color: @bg0;
    text-color:         @fg1;
}

element selected.normal {
    background-color: @selected;
    text-color:         @selected-fg;
}

element-icon {
    size:       1.2em;
    padding:    0px 8px 0px 0px;
    background-color: transparent;
}

element-text {
    text-color: inherit;
    background-color: transparent;
    vertical-align: 0.5;
}

element-icon selected.normal,
element-text selected.normal {
    text-color: @selected-fg;
}
